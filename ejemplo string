// FUNCIONES

int ContarVocales(string cadena)
{
    int cont = 0;
    for (int i = 0; i < cadena.length(); i++)
        if (cadena[i]=='a'||cadena[i]=='e'||cadena[i]=='i'||cadena[i]=='o'||cadena[i]=='u')
            cont++;
    return cont;
}

int Longitud(string cadena)
{
    return cadena.length();
}

string ExtraerParte(string cadena, int pos)
{
    return cadena.substr(pos, cadena.length() - pos);
}

void Intercambiar(string &a, string &b)
{
    string aux = a;
    a = b;
    b = aux;
}

bool Comparar(string a, string b)
{
    return a == b;
}

bool Encontrar(string cadena, char c)
{
    return cadena.find(c) != string::npos;
}

string Invertir(string cadena)
{
    string aux = cadena;
    int n = cadena.length();

    for (int i = 0; i < n/2; i++)
    {
        char temp = aux[i];
        aux[i] = aux[n-1-i];
        aux[n-1-i] = temp;
    }
    return aux;
}

bool EsCapicua(string cadena)
{
    return cadena == Invertir(cadena);
}

string QuitarVocales(string cadena)
{
    string resultado = "";

    for (int i = 0; i < cadena.length(); i++)
        if (cadena[i]!='a' && cadena[i]!='e' && cadena[i]!='i' && cadena[i]!='o' && cadena[i]!='u')
            resultado += cadena[i];

    return resultado;
}