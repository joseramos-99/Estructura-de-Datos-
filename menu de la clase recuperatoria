#include <iostream>

using namespace std;

int main() {
    int opcion,base,altura;
    int N;
    float numero, suma=0, promedio;
    int a,b,c, mayor;
    do {
        cout << "1.Calcular area del triangulo"<<endl;
        cout << "2.Encontrar el mayor de 3 numeros"<<endl;
        cout << "3.Encontrar el promedio de N numeros"<<endl;
        cout << "0.Salir"<<endl;
        cout << "Ingresar la opcion: ";
        cin  >> opcion;
        switch(opcion){
          case 1:
            cout<<"Ingresa la base: ";
            cin >>base;
            cout<<"Ingresa la altura: ";
            cin >> altura;
            cout<<"El area del triangulo es: "<<base*altura/2.0;
            break;
          case 2:
            cout<<"Ingrese el primer valor: ";
            cin >> a;
            cout << "Ingrese el segundo valor: ";
            cin >> b;
            cout <<"Ingease el tercer valor: ";
            cin >> c;
            if (a >= b&&a >= c){
                mayor = a;
            }    
            else if (b >= a && b >= c){
                mayor = b;
            }   
            else {
                mayor = c;  
            }
            cout<< "El mayor de los numeros es"<<mayor<<endl;
            break;
          case 3:
            cout << "Ingresa la cantidad de numeros: ";
            cin >> N;
            for (int i = 1 ; i <= N; i++) {
                cout << "Ingrese el numero"<< i << ": ";
                cin >> numero; 
                suma = suma + numero;
            }
            
            promedio = suma / N;
            
            cout << "El promedio es"<<promedio<<endl; 
                
            break;
          case 0:
            cout<<"salir del programa";
            break;
        default:
            cout << "Error invalido"<<endl;
            break; 
        }
      } while (opcion=!0);
     return 0;
    }
